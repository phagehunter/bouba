{
  "id": "ja",
  "name": "Japanese",
  "packVersion": "0.0.0-s5",
  "about": "How Japanese speakers adapt names written in English spelling, following the habits of katakana spelling. Every rule names its source and a confidence level. Edit this file to correct or add rules; no programming is needed.",
  "profiles": {
    "traditional": "The long-established katakana habits. Sound pairs Japanese did not have are replaced: 'ti' becomes 'chi', 'di' becomes 'ji', 'tu' becomes 'tsu', V becomes B, and 'wi' becomes 'ui'.",
    "younger": "The newer katakana habits, which keep more of the original: 'ti', 'di', 'tu' and 'wi' are written with their own letters (ティ, ディ, トゥ, ウィ)."
  },
  "profileLabels": {
    "traditional": "Established spelling",
    "younger": "Newer spelling"
  },
  "scriptName": "katakana",
  "accuracy": "The predicted katakana was compared with the first spelling listed in the JMdict dictionary for English loanwords. On 1,500 words the rules had not been adjusted to, the average similarity was 88.1% under \"Established spelling\" and 89.9% under \"Newer spelling\", with 933 and 985 matching exactly. This measures agreement with dictionary spellings. Pronunciation itself was not measured, and the word lists contain some mismatched pairs.",
  "sources": {
    "jmdict": "English loanwords in JMdict, the Japanese-English dictionary project (Electronic Dictionary Research and Development Group), CC BY-SA 4.0. The rule follows dictionary spellings.",
    "unverified": "Background knowledge of the pack author; not checked against a source. Corrections welcome."
  },
  "effortPoints": {
    "substitution": 6,
    "epenthesis": 12,
    "finalChanged": 10,
    "finalDropped": 8,
    "clusterKept": 5,
    "rDropped": 1,
    "codaAfterDiphthong": 10,
    "nonNativeFinalKept": 10
  },
  "respellingKey": [
    [
      "-",
      "separates beats; Japanese gives each beat about the same length"
    ],
    [
      "a",
      "as in 'father', short"
    ],
    [
      "i",
      "as in 'machine', short"
    ],
    [
      "u",
      "as in 'put', with the lips relaxed"
    ],
    [
      "e",
      "as in 'bed'"
    ],
    [
      "o",
      "as in 'more', short"
    ],
    [
      "aa, ii, uu, ee, oo",
      "the same vowel held for two beats"
    ],
    [
      "ai, ei, oi, au",
      "two vowels said one after the other, as in 'eye', 'day', 'boy', 'now'"
    ],
    [
      "r",
      "a light tap of the tongue, between English R, L and D"
    ],
    [
      "f",
      "a soft F made with both lips, as when blowing out a candle"
    ],
    [
      "n at the end of a beat",
      "a hummed N that takes a full beat"
    ],
    [
      "a doubled consonant across a hyphen (bak-ku, kyat-to)",
      "a short stop before the consonant, as in 'book-keeper'"
    ],
    [
      "tsu",
      "as in 'cats'"
    ],
    [
      "ky, gy, ny, hy, my, ry, py, by",
      "the consonant followed by a quick Y, as in 'cute'"
    ]
  ],
